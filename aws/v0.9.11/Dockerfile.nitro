# Co-signer audit image for an AWS Nitro Enclave on our own EC2 parent.
#
# deploy-aws.sh turns this image into an enclave image file (EIF) with
# nitro-cli build-enclave; the Nitro hypervisor measures the EIF as PCR0 (all
# of it), PCR1 (kernel and boot ramfs) and PCR2 (this image's file system,
# command and environment). Everything below is attested: the binaries, the
# scorer and every ENV. The measured settings (release tag, sealed-settings
# commitment, platform, key mode, price source, audit modes, and the KMS
# ciphertexts of the secrets) are baked in as build args: one tag = one EIF =
# one PCR0 = one attested key.
#
# deploy-aws.sh builds from a context it stages with `git archive` at a clean
# commit (shared/, backend/, the replayed tee/ code and the scorer only), with
# SOURCE_DATE_EPOCH set to the commit time and timestamps rewritten, so anyone
# can rebuild the same tree with the same build args and compare PCRs.
#
# Secrets (AUDIT_SECRET_CONFIG, AUDIT_SECRET_TELEGRAM_BOT_TOKEN) are in the
# image only as KMS ciphertexts (AUDIT_AWS_SECRETS). The enclave asks KMS to
# decrypt them with an attestation document; the key policy lets only this
# release's PCR0 do so, and the answer is encrypted to a key that never
# leaves the enclave. The binary refuses AUDIT_SECRET_CONFIG unless it
# matches the measured commitment.
#
# The enclave has no network, only vsock. nitro-init (PID 1) brings up lo and
# bridges: vsock :8090 -> 127.0.0.1:8090 (the co-signer), 127.0.0.1:3128 ->
# the parent's allowlisted CONNECT proxy, 127.0.0.1:8002 -> the parent's
# IMDS proxy (the role's credentials for KMS). TLS ends inside the enclave.

# golang:1.25.6-bookworm on the build host's platform, cross-compiling static
# linux/amd64 binaries: the parent is an m6a (x86-64).
FROM --platform=$BUILDPLATFORM golang@sha256:f4490d7b261d73af4543c46ac6597d7d101b6e1755bcdd8c5159fda7046b6b3e AS build
ARG SOURCE_DATE_EPOCH=0
# GIT_COMMIT stamps the replayed TEE code (tee/internal/buildinfo.Commit)
# exactly as the TEE binary is stamped; see Dockerfile.gcp.
ARG GIT_COMMIT=unknown
# TEE_CODE_HASH is scripts/tee-code-hash.sh at that commit: the replay
# matches an operation only when its teeBuild equals it.
ARG TEE_CODE_HASH=unknown
WORKDIR /src
COPY shared/go.mod shared/go.sum ./shared/
COPY tee/go.mod tee/go.sum ./tee/
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && GOWORK=off GOFLAGS=-mod=readonly go mod download
COPY shared/ ./shared/
# Only the replay package and the TEE code it runs: no keys, tests or binaries.
COPY tee/internal/ ./tee/internal/
COPY tee/replay/ ./tee/replay/
COPY backend/ ./backend/
RUN cd backend && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOWORK=off GOFLAGS=-mod=readonly go build -trimpath -buildvcs=false -ldflags="-s -w -buildid= -X github.com/orbs/perpetual-hub/tee/internal/buildinfo.Commit=${GIT_COMMIT} -X github.com/orbs/perpetual-hub/tee/internal/buildinfo.CodeHash=${TEE_CODE_HASH}" -o /out/cosigner-audit ./cmd/cosigner-audit && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOWORK=off GOFLAGS=-mod=readonly go build -trimpath -buildvcs=false -ldflags="-s -w -buildid=" -o /out/nitro-init ./cmd/nitro-init && \
    touch -d "@${SOURCE_DATE_EPOCH}" /out/cosigner-audit /out/nitro-init
# No enclave image carries a binary built with a test-only build tag
# (restinglimits, teefakebinance): a tagged image measures differently and is
# never granted ROLLUP_VERIFIER_ROLE, but the build refuses it first. Inline,
# not a copied script, so the git-archive build context stays unchanged.
# ops/deploy/test-build-tag-gate.sh runs this exact step on real binaries.
RUN for bin in /out/cosigner-audit /out/nitro-init; do \
      info="$(go version -m "$bin")" || { echo "refusing ${bin}: no readable Go build info" >&2; exit 1; }; \
      tags="$(printf '%s\n' "$info" | awk '$1 == "build" && index($2, "-tags=") == 1 { print substr($2, 7) }' | tr ',' ' ')"; \
      for tag in $tags; do \
        case "$tag" in restinglimits|teefakebinance) echo "refusing ${bin}: built with test-only tag ${tag}" >&2; exit 1 ;; esac; \
      done; \
    done

# python:3.12.11-slim-bookworm (the deterministic scorer is standard-library
# only), pinned to amd64.
FROM --platform=linux/amd64 python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
ARG AUDIT_RELEASE_TAG
ARG AUDIT_CONFIG_COMMITMENT
ARG AUDIT_PRICE_SOURCE=binance-futures
ARG AUDIT_MODES=light
ARG AUDIT_AWS_KMS_REGION
ARG AUDIT_AWS_SECRETS
COPY --from=build /out/cosigner-audit /app/cosigner-audit
COPY --from=build /out/nitro-init /app/nitro-init
COPY skills/analyze-perpetual-user-health/scripts/calculate_health_score.py /app/skills/analyze-perpetual-user-health/scripts/calculate_health_score.py
ENV AUDIT_RELEASE_TAG=${AUDIT_RELEASE_TAG} \
    AUDIT_CONFIG_COMMITMENT=${AUDIT_CONFIG_COMMITMENT} \
    AUDIT_PLATFORM=aws \
    AUDIT_KEY_MODE=aws-nitro \
    AUDIT_PRICE_SOURCE=${AUDIT_PRICE_SOURCE} \
    AUDIT_MODES=${AUDIT_MODES} \
    AUDIT_SECRETS_SOURCE=aws-kms \
    AUDIT_AWS_KMS_REGION=${AUDIT_AWS_KMS_REGION} \
    AUDIT_AWS_SECRETS=${AUDIT_AWS_SECRETS} \
    AUDIT_LISTEN_ADDR=127.0.0.1:8090 \
    AUDIT_REPO_PATH=/app \
    HTTPS_PROXY=http://127.0.0.1:3128 \
    HTTP_PROXY=http://127.0.0.1:3128 \
    AWS_EC2_METADATA_SERVICE_ENDPOINT=http://127.0.0.1:8002
WORKDIR /app
ENTRYPOINT ["/app/nitro-init"]
